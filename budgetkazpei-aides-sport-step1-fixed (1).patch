diff --git a/scripts/run-aides-sport-ranking-tests.mjs b/scripts/run-aides-sport-ranking-tests.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/run-aides-sport-ranking-tests.mjs
@@ -0,0 +1,71 @@
+import assert from "node:assert/strict"
+
+import { matchesAidSearch } from "../src/services/aidesSearch.js"
+import { rankAidesForAdvisor } from "../src/services/aidesRanking.js"
+
+const sportSearchAide = {
+  nameFr: "Pass'Sport",
+  nameKr: "Pass'Sport",
+  descriptionFr: "Aide pour réduire le coût d'une licence ou cotisation dans un club sportif.",
+  descriptionKr: "Aide pou réduit pri licence ou cotisation dann in club sportif.",
+  stepsFr: "Vérifier l'éligibilité sur le site officiel.",
+  stepsKr: "Vérifie éligibilité su site officiel.",
+  category: "sport",
+}
+
+for (const query of ["sport", "club", "licence", "judo", "tennis", "surf"]) {
+  assert.equal(
+    matchesAidSearch(sportSearchAide, query),
+    true,
+    `La recherche sport doit trouver une aide sportive avec : ${query}`,
+  )
+}
+
+const aides = [
+  {
+    id: "apl",
+    nom: "Aide personnalisée au logement",
+    categorie: "logement",
+    description_fr: "Aide au paiement du logement.",
+    score_priorite: 260,
+  },
+  {
+    id: "pass_sport",
+    nom: "Pass'Sport",
+    categorie: "sport",
+    description_fr: "Aide à l'inscription, à la licence ou à la cotisation dans un club sportif.",
+    besoin_enfant: true,
+    score_priorite: 80,
+  },
+  {
+    id: "plan_5000_licences",
+    nom: "Plan 5000 licences",
+    categorie: "sport",
+    organisme: "Département de La Réunion",
+    description_fr: "Aide pour financer une licence et une cotisation dans un club sportif.",
+    besoin_enfant: true,
+    score_priorite: 75,
+  },
+]
+
+const genericRanking = rankAidesForAdvisor(
+  aides,
+  { nombre_enfants: 2, logement: "locataire" },
+  "Je cherche une aide financière pour le sport de mes enfants",
+)
+
+assert.deepEqual(
+  genericRanking.slice(0, 2).map(aide => aide.id).sort(),
+  ["pass_sport", "plan_5000_licences"],
+  "Une demande sport enfants doit faire passer les aides sport avant une aide générale mieux scorée",
+)
+
+const namedRanking = rankAidesForAdvisor(
+  aides,
+  { nombre_enfants: 2 },
+  "Est-ce que le plan 5000 licences peut m'aider ?",
+)
+
+assert.equal(namedRanking[0].id, "plan_5000_licences")
+
+console.log("✓ Recherche et ranking sport / licences vérifiés")
